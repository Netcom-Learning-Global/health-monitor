require("dotenv").config();

const app = require("#src/app");
const http = require("http");
const logger = require("#src/config/logging/winston");
const { startHealthScheduler } = require("#src/services/scheduler");

const port = normalizePort(process.env.PORT || "3090");
const server = http.createServer(app);

server.listen(port);
server.on("error", onError);
server.on("listening", onListening);

startHealthScheduler().catch((err) => {
	logger.error(`Health scheduler failed to start: ${err.message}`);
	process.exit(1);
});

function normalizePort(val) {
	const parsed = parseInt(val, 10);
	if (Number.isNaN(parsed)) return val;
	if (parsed >= 0) return parsed;
	return false;
}

function onError(error) {
	if (error.syscall !== "listen") throw error;

	const bind = typeof port === "string" ? `Pipe ${port}` : `Port ${port}`;
	switch (error.code) {
		case "EACCES":
			logger.error(`${bind} requires elevated privileges`);
			process.exit(1);
			break;
		case "EADDRINUSE":
			logger.error(`${bind} is already in use`);
			process.exit(1);
			break;
		default:
			throw error;
	}
}

function onListening() {
	const addr = server.address();
	const bind = typeof addr === "string" ? `Pipe ${addr}` : `Port ${addr.port}`;
	logger.info(`Health monitor listening on ${bind}`);
}
