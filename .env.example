PORT=3090
NODE_ENV=development
LOG_LEVEL=info

# Poll all services every 30 seconds
HEALTH_POLL_INTERVAL_MS=30000
HEALTH_CACHE_TTL_SECONDS=120
HEALTH_RETRY_ATTEMPTS=3
HEALTH_REQUEST_TIMEOUT_MS=5000
HEALTH_RETRY_BACKOFF_MS=1000

# Redirect when any monitored service is down
MAINTENANCE_PORTAL_URL=https://aicert.lms.com
ALLOWED_ORIGINS=*

# Optional Slack alerts on UP/DOWN transitions
SLACK_WEBHOOK_URL=

# Redis (optional — falls back to in-memory cache if REDIS_HOST is empty)
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Microservice base URLs (adjust for your environment)
AUTH_SERVICE_URL=http://localhost:3000
COMMUNICATION_SERVICE_URL=http://localhost:3001
ADMIN_MANAGEMENT_URL=http://localhost:3003
PROCTORING_BACKEND_URL=http://localhost:3030
RABBITMQ_CONSUMER_URL=http://localhost:3004
IO_HANDLER_URL=http://localhost:3010
WEBRTC_SERVER_URL=http://localhost:4000
